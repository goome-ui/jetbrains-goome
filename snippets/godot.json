{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "a floating ui window over the game, drawn by a GoomeView",
    "body": [
      "extends GoomeView",
      "",
      "",
      "func _goome_frame(ui: GoomeUI) -> void:",
      "\tif ui.window(\"${1:my overlay}\", Rect2(60, 60, 280, 0), GoomeUI.WIN_MOVE | GoomeUI.WIN_CLOSE):",
      "\t\tui.label(\"${2:im on top of your game}\")",
      "\t\t$0",
      "\tui.window_end()"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "an app window that the ui fills, a GoomeView script",
    "body": [
      "extends GoomeView",
      "",
      "",
      "func _ready() -> void:",
      "\tget_window().title = \"${1:My App}\"",
      "\tget_window().size = Vector2i(${2:960}, ${3:640})",
      "",
      "",
      "func _goome_frame(ui: GoomeUI) -> void:",
      "\tif ui.app_begin(\"$1\", 0):",
      "\t\tui.heading(\"${4:Hello}\")",
      "\t\t$0",
      "\tui.app_end()"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "frame callback that only redraws when input came in or something animates",
    "body": [
      "func _ready() -> void:",
      "\tredraw_every_frame = false",
      "",
      "",
      "func _goome_frame(ui: GoomeUI) -> void:",
      "\t$0"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "if ui.window(\"${1:Window}\", Rect2(40, 40, 300, 0), GoomeUI.WIN_MOVE | GoomeUI.WIN_RESIZE | GoomeUI.WIN_COLLAPSE):",
      "\tui.label(\"${2:hello}\")",
      "\tif ui.button(\"${3:Click me}\"):",
      "\t\t$0",
      "ui.window_end()"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the view yourself with the draw calls, no widgets",
    "body": [
      "extends GoomeView",
      "",
      "",
      "func _goome_frame(ui: GoomeUI) -> void:",
      "\tui.draw_rect(Rect2(${1:40}, ${2:40}, ${3:200}, ${4:80}), Color(\"1b1d22\"), 10.0)",
      "\tui.draw_text(Vector2($1 + 12, $2 + 12), \"${5:hello}\", Color(\"e9ebee\"))",
      "\t$0"
    ]
  },
  "goome label": {
    "prefix": "goome-label",
    "description": "label",
    "body": [
      "ui.label(\"${1:some text}\")"
    ]
  },
  "goome heading": {
    "prefix": "goome-heading",
    "description": "heading",
    "body": [
      "ui.heading(\"${1:Heading}\")"
    ]
  },
  "goome wrapped": {
    "prefix": "goome-wrapped",
    "description": "text that wraps at the edge",
    "body": [
      "ui.wrapped(\"${1:this text wraps when it runs into the edge}\")"
    ]
  },
  "goome button": {
    "prefix": "goome-button",
    "description": "button",
    "body": [
      "if ui.button(\"${1:Click me}\"):",
      "\t$0"
    ]
  },
  "goome checkbox": {
    "prefix": "goome-checkbox",
    "description": "checkbox, returns the new value",
    "body": [
      "${2:show_grid} = ui.checkbox(\"${1:Show grid}\", $2)"
    ]
  },
  "goome toggle": {
    "prefix": "goome-toggle",
    "description": "toggle switch, returns the new value",
    "body": [
      "${2:wifi} = ui.toggle(\"${1:Wi-Fi}\", $2)"
    ]
  },
  "goome radio": {
    "prefix": "goome-radio",
    "description": "radio buttons on one int",
    "body": [
      "${2:size} = ui.radio(\"${1:Small}\", $2, 0)",
      "ui.same_line()",
      "$2 = ui.radio(\"${3:Large}\", $2, 1)"
    ]
  },
  "goome slider": {
    "prefix": "goome-slider",
    "description": "slider, returns the new value",
    "body": [
      "${2:volume} = ui.slider(\"${1:Volume}\", $2, ${3:0.0}, ${4:1.0}, \"${5:%.2f}\")"
    ]
  },
  "goome slider int": {
    "prefix": "goome-slider-int",
    "description": "int slider, returns the new value",
    "body": [
      "${2:count} = ui.slider_int(\"${1:Count}\", $2, ${3:0}, ${4:100})"
    ]
  },
  "goome input": {
    "prefix": "goome-input",
    "description": "one line text input",
    "body": [
      "${2:player} = ui.input(\"${1:Name}\", $2, ${3:64})"
    ]
  },
  "goome password": {
    "prefix": "goome-password",
    "description": "password input",
    "body": [
      "${2:password} = ui.password(\"${1:Password}\", $2, ${3:64})"
    ]
  },
  "goome combo": {
    "prefix": "goome-combo",
    "description": "dropdown",
    "body": [
      "${2:fruit} = ui.combo(\"${1:Fruit}\", $2, PackedStringArray([\"${3:Mango}\", \"${4:Banana}\", \"${5:Cherry}\"]))"
    ]
  },
  "goome selectable": {
    "prefix": "goome-selectable",
    "description": "selectable list row",
    "body": [
      "if ui.selectable(\"${1:Item}\", ${2:picked} == ${3:0}):",
      "\t$2 = $3"
    ]
  },
  "goome tabs": {
    "prefix": "goome-tabs",
    "description": "tabs",
    "body": [
      "${2:tab} = ui.tabs(\"${1:tabs}\", PackedStringArray([\"${3:General}\", \"${4:Advanced}\"]), $2)",
      "if $2 == 0:",
      "\t$0"
    ]
  },
  "goome collapsing": {
    "prefix": "goome-collapsing",
    "description": "collapsing section",
    "body": [
      "if ui.collapsing(\"${1:More stuff}\"):",
      "\t$0"
    ]
  },
  "goome tree": {
    "prefix": "goome-tree",
    "description": "tree node, goome remembers if its open",
    "body": [
      "if ui.tree(\"${1:src}\"):",
      "\t$0",
      "\tui.tree_end()"
    ]
  },
  "goome progress": {
    "prefix": "goome-progress",
    "description": "progress bar",
    "body": [
      "ui.progress(${1:0.6}, \"${2:60%}\")"
    ]
  },
  "goome color": {
    "prefix": "goome-color",
    "description": "color picker, returns the new color",
    "body": [
      "${2:highlight} = ui.color(\"${1:Highlight}\", $2)"
    ]
  },
  "goome tooltip": {
    "prefix": "goome-tooltip",
    "description": "tooltip for the widget before it",
    "body": [
      "ui.tooltip(\"${1:what it does}\")"
    ]
  },
  "goome row": {
    "prefix": "goome-row",
    "description": "next widgets go side by side",
    "body": [
      "ui.row(${1:2})"
    ]
  },
  "goome same line": {
    "prefix": "goome-same-line",
    "description": "next widget on the same line",
    "body": [
      "ui.same_line()"
    ]
  },
  "goome separator": {
    "prefix": "goome-separator",
    "description": "separator line",
    "body": [
      "ui.separator()"
    ]
  },
  "goome space": {
    "prefix": "goome-space",
    "description": "empty space",
    "body": [
      "ui.space(${1:12})"
    ]
  },
  "goome scroll": {
    "prefix": "goome-scroll",
    "description": "scroll area",
    "body": [
      "if ui.scroll_begin(\"${1:list}\", ${2:150}):",
      "\t$0",
      "ui.scroll_end()"
    ]
  },
  "goome split": {
    "prefix": "goome-split",
    "description": "split panes, panes is a Split",
    "body": [
      "if ui.split_begin(\"${1:main}\", false, ${2:0.3}):",
      "\t$0",
      "\tui.split_next()",
      "ui.split_end()"
    ]
  },
  "goome menubar": {
    "prefix": "goome-menubar",
    "description": "menu bar with a File menu",
    "body": [
      "if ui.menubar_begin():",
      "\tif ui.menu_begin(\"${1:File}\"):",
      "\t\tif ui.menu_item(\"${2:Open}\", \"${3:Ctrl+O}\"):",
      "\t\t\t$0",
      "\t\tui.menu_separator()",
      "\t\tif ui.menu_item(\"Quit\", \"Ctrl+Q\"):",
      "\t\t\tget_tree().quit()",
      "\t\tui.menu_end()",
      "\tui.menubar_end()"
    ]
  },
  "goome popup": {
    "prefix": "goome-popup",
    "description": "button that opens a popup",
    "body": [
      "if ui.button(\"${1:More}\"):",
      "\tui.popup_open(\"${2:more}\")",
      "if ui.popup_begin(\"$2\"):",
      "\t$0",
      "\tui.popup_end()"
    ]
  },
  "goome context": {
    "prefix": "goome-context",
    "description": "right click menu for the widget before it",
    "body": [
      "if ui.context_begin(\"${1:ctx}\"):",
      "\tif ui.menu_item(\"${2:Delete}\"):",
      "\t\t$0",
      "\tui.context_end()"
    ]
  },
  "goome modal": {
    "prefix": "goome-modal",
    "description": "modal with a Done button",
    "body": [
      "if ui.button(\"${1:Open settings}\"):",
      "\tui.modal_open(\"${2:Settings}\")",
      "if ui.modal_begin(\"$2\"):",
      "\t$0",
      "\tif ui.button(\"Done\"):",
      "\t\tui.popup_close()",
      "\tui.modal_end()"
    ]
  },
  "goome toast": {
    "prefix": "goome-toast",
    "description": "toast message",
    "body": [
      "ui.toast(\"${1:Saved}\", ${2:2500})"
    ]
  },
  "goome text edit": {
    "prefix": "goome-text-edit",
    "description": "multiline text editor on a TextBuffer",
    "body": [
      "${2:notes} = ui.text_edit(\"${1:notes}\", $2, ${3:140}, GoomeUI.EDIT_WRAP)"
    ]
  },
  "goome table": {
    "prefix": "goome-table",
    "description": "table with sortable columns",
    "body": [
      "if ui.table_begin(\"${1:files}\", 2, ${2:200}, GoomeUI.TABLE_SORTABLE | GoomeUI.TABLE_STRIPES):",
      "\tui.table_column(\"${3:Name}\")",
      "\tui.table_column(\"${4:Size}\", 90)",
      "\t${5:sort} = ui.table_sort($5)",
      "\tfor i in ${6:count}:",
      "\t\tui.table_row()",
      "\t\tui.label(str(i))",
      "\t\tui.table_next()",
      "\t\tui.label(\"$0\")",
      "ui.table_end()"
    ]
  },
  "goome drag float": {
    "prefix": "goome-drag-float",
    "description": "drag a number left and right",
    "body": [
      "${2:speed} = ui.drag_float(\"${1:Speed}\", $2, ${3:0.01}, ${4:0}, ${5:10}, \"${6:%.2f}\")"
    ]
  },
  "goome number": {
    "prefix": "goome-number",
    "description": "number box with - and + buttons",
    "body": [
      "${2:amount} = ui.number(\"${1:Amount}\", $2, ${3:1}, \"${4:%.0f}\")"
    ]
  },
  "goome plot": {
    "prefix": "goome-plot",
    "description": "line plot from a float array",
    "body": [
      "ui.plot_lines(\"${1:CPU}\", ${2:values}, ${3:0}, ${4:100}, ${5:90})"
    ]
  },
  "goome plot bars": {
    "prefix": "goome-plot-bars",
    "description": "bar plot from a float array",
    "body": [
      "ui.plot_bars(\"${1:Requests}\", ${2:values}, ${3:0}, ${4:20}, ${5:90})"
    ]
  },
  "goome spinner": {
    "prefix": "goome-spinner",
    "description": "loading spinner",
    "body": [
      "ui.spinner(${1:0})"
    ]
  },
  "goome link": {
    "prefix": "goome-link",
    "description": "clickable link",
    "body": [
      "if ui.link(\"${1:goome docs}\"):",
      "\t$0"
    ]
  },
  "goome badge": {
    "prefix": "goome-badge",
    "description": "little colored badge",
    "body": [
      "ui.badge(\"${1:new}\", ${2:Color(\"6fdc5f\")})"
    ]
  },
  "goome style": {
    "prefix": "goome-style",
    "description": "push a color and a size, pop them after",
    "body": [
      "var ${1:n} := ui.push_style({\"${2:accent}\": ${3:Color(\"ff5050\")}, \"${4:radius}\": ${5:4.0}})",
      "$0",
      "ui.pop($1)"
    ]
  },
  "goome style push": {
    "prefix": "goome-style-push",
    "description": "push and pop by hand",
    "body": [
      "ui.push_color(GoomeUI.S_${1|ACCENT,BG,PANEL,BORDER,TEXT,TEXT_DIM,HOVER,ACTIVE,INPUT_BG|}, ${2:Color(\"ff5050\")})",
      "ui.push_num(GoomeUI.S_${3|RADIUS,PAD,GAP,BORDER_WIDTH,FONT_SIZE|}, ${4:4.0})",
      "$0",
      "ui.pop(2)"
    ]
  },
  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "var ${1:gain} := ui.store(\"$1\", 1)",
      "var it := ui.custom(\"$1\", ${2:80}, ${3:80}, GoomeUI.ITEM_DRAG_Y | GoomeUI.ITEM_FOCUSABLE)",
      "if it.held:",
      "\t$1[0] = clampf($1[0] - it.dy / 200, 0, 1)",
      "\tui.store_set(\"$1\", $1)",
      "ui.draw_arc(Vector2(it.x + 40, it.y + 40), 30, 2.36, 2.36 + 4.71 * $1[0], ui.theme_get(\"accent\"), 6)"
    ]
  },
  "goome hotkey": {
    "prefix": "goome-hotkey",
    "description": "key shortcut on the view, only fires while the game window has focus",
    "body": [
      "func _unhandled_key_input(event: InputEvent) -> void:",
      "\tif event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_${1:F1}:",
      "\t\t$0"
    ]
  },
  "goome theme preset": {
    "prefix": "goome-theme-preset",
    "description": "use a built in theme",
    "body": [
      "ui.theme_preset(GoomeUI.PRESET_${1|DARK,LIGHT,MIDNIGHT,PAPER,MINT,HIGH_CONTRAST,ROSE|})"
    ]
  },
  "goome theme make": {
    "prefix": "goome-theme-make",
    "description": "make a theme from one accent color",
    "body": [
      "ui.theme_make(${1:Color(\"4fa3ff\")}, ${2:true}, ${3:10.0})"
    ]
  },
  "goome ease": {
    "prefix": "goome-ease",
    "description": "raw easing curve, t goes 0 to 1",
    "body": [
      "var ${1:k} := ui.ease(GoomeUI.EASE_${2|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|}, ${3:t})"
    ]
  },
  "goome anim": {
    "prefix": "goome-anim",
    "description": "animate a number toward a target, call it every frame",
    "body": [
      "var ${1:x} := ui.anim(\"${2:panel x}\", ${3:0.0 if open else -300.0}, ${4:250}, GoomeUI.EASE_${5|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|})"
    ]
  },
  "goome anim color": {
    "prefix": "goome-anim-color",
    "description": "animate a color toward a target, call it every frame",
    "body": [
      "var ${1:bg} := ui.anim_color(\"${2:bg}\", ${3:Color(\"3a7bd5\") if hot else Color(\"202020\")}, ${4:150}, GoomeUI.EASE_${5|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|})"
    ]
  },
  "goome text input": {
    "prefix": "goome-text-input",
    "description": "ime signals for typed and composing text, goome puts the candidate window at the caret itself",
    "body": [
      "func _ready() -> void:",
      "\time_text.connect(_on_typed)",
      "\time_preedit.connect(_on_composing)",
      "",
      "",
      "func _on_typed(${1:typed}: String) -> void:",
      "\t$0",
      "",
      "",
      "func _on_composing(${2:composing}: String, ${3:at}: int) -> void:",
      "\tpass"
    ]
  },
  "goome a11y": {
    "prefix": "goome-a11y",
    "description": "screen reader role, name and value for the next custom item",
    "body": [
      "ui.a11y(true)",
      "ui.a11y_role(GoomeUI.ROLE_${1|SLIDER,BUTTON,CHECKBOX,PROGRESS,IMAGE,GROUP|}, \"${2:Volume}\")",
      "ui.a11y_value(${3:\"50%\"})"
    ]
  },
  "goome font fallback": {
    "prefix": "goome-font-fallback",
    "description": "font that falls back to another one for chars it doesnt have",
    "body": [
      "ui.font_fallback(\"${1:Inter}\", \"${2:Noto Sans CJK JP}\")"
    ]
  },
  "goome text dir": {
    "prefix": "goome-text-dir",
    "description": "force the text direction for all text",
    "body": [
      "ui.text_dir(GoomeUI.DIR_${1|RTL,LTR,AUTO|})"
    ]
  }
}