{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "\"use strict\";",
      "const goome = require(\"goome\");",
      "",
      "function main() {",
      "\tlet g;",
      "\ttry {",
      "\t\tg = goome.open(\"${2:my overlay}\");",
      "\t} catch (e) {",
      "\t\tconsole.error(`couldnt open an overlay: \\${e.message}`);",
      "\t\treturn 1;",
      "\t}",
      "\tconst ui = g.ui();",
      "\tconst win = { x: 60, y: 60, w: 280, h: 0, open: true };",
      "\twhile (win.open) {",
      "\t\tfor (const ev of g.events(16)) {",
      "\t\t\tif (ev.type === goome.QUIT) win.open = false;",
      "\t\t\tui.feed(ev);",
      "\t\t}",
      "\t\tif (!win.open || !ui.begin(0)) continue;",
      "\t\tif (ui.window(\"$2\", win, goome.WIN_MOVE | goome.WIN_CLOSE)) {",
      "\t\t\tui.label(\"${3:im on top of everything}\");",
      "\t\t\t$0",
      "\t\t}",
      "\t\tui.windowEnd();",
      "\t\tui.end();",
      "\t}",
      "\tui.close();",
      "\tg.close();",
      "\treturn 0;",
      "}",
      "",
      "process.exitCode = main();"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "\"use strict\";",
      "const goome = require(\"goome\");",
      "",
      "function main() {",
      "\tlet g;",
      "\ttry {",
      "\t\tg = goome.openApp(\"${2:My App}\", ${3:960}, ${4:640});",
      "\t} catch (e) {",
      "\t\tconsole.error(`couldnt open a window: \\${e.message}`);",
      "\t\treturn 1;",
      "\t}",
      "\tconst ui = g.ui();",
      "\tlet running = true;",
      "\twhile (running) {",
      "\t\tfor (const ev of g.events(16)) {",
      "\t\t\tif (ev.type === goome.QUIT || ev.type === goome.CLOSE) running = false;",
      "\t\t\tui.feed(ev);",
      "\t\t}",
      "\t\tif (!running || !ui.begin(0)) continue;",
      "\t\tui.app(\"$2\");",
      "\t\tui.heading(\"${5:Hello}\");",
      "\t\t$0",
      "\t\tui.appEnd();",
      "\t\tui.end();",
      "\t}",
      "\tui.close();",
      "\tg.close();",
      "\treturn 0;",
      "}",
      "",
      "process.exitCode = main();"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "const pace = new goome.Pacer(${1:60});",
      "let running = true, dirty = true;",
      "while (running) {",
      "\tconst wait = dirty || ${2:ui}.animating ? pace.wait() : 500;",
      "\tfor (let ev = ${3:g}.poll(wait); ev; ev = $3.poll(0)) {",
      "\t\tif (ev.type === goome.QUIT || ev.type === goome.CLOSE) running = false;",
      "\t\t$2.feed(ev);",
      "\t\tdirty = true;",
      "\t}",
      "\tif (!running) break;",
      "\tif (!dirty && !$2.animating) continue;",
      "\tdirty = false;",
      "\tif (!$2.begin(0)) continue;",
      "\t$0",
      "\t$2.end();",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
