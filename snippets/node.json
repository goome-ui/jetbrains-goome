      "const ui = g.ui();",
      "g.pushClick(${3:60}, ${4:60}, 1);",
      "for (const ev of g.events(0)) ui.feed(ev);",
      "if (ui.begin(0)) {",
      "\tui.app(\"${5:offscreen}\");",
      "\t$0",
      "\tui.appEnd();",
      "\tui.end();",
      "}",
      "g.lastFrame().savePpm(\"${6:frame.ppm}\");",
      "ui.close();",
      "g.close();"
    ]
  },
