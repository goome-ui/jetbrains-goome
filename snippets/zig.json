  "goome text input": {
    "prefix": "goome-text-input",
    "description": "ime on with the candidate window at the caret, plus typed and composing text",
    "body": [
      "try ${1:g}.textInput(${2:focused}, goome.rect(${3:x}, ${4:y}, 2, ${5:20}));",
      "$0",
      "if (ev.kind == .text) {",
      "\tconst ${6:typed} = $1.eventText();",
      "\t_ = $6;",
      "} else if (ev.kind == .preedit) {",
      "\tconst ${7:composing} = $1.eventText();",
      "\tconst ${8:at} = $1.preeditCursor();",
