    ]
  },
  "goome font fallback": {
    "prefix": "goome-font-fallback",
    "description": "font that falls back to another one for chars it doesnt have",
    "body": [
      "const ${1:font} = try goome.Font.load(\"${2:Inter.ttf}\");",
      "$1.fallback(try goome.Font.load(\"${3:NotoSansCJK.ttc}\"));"
