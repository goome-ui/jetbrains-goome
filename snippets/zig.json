  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "var it: goome.Item = .{};",
      "_ = ui.custom(\"${1:gain}\", ${2:80}, ${3:80}, goome.c.GOOME_ITEM_DRAG_Y | goome.c.GOOME_ITEM_FOCUSABLE, &it);",
      "if (ui.store(\"$1\", 1)) |$1| {",
      "\tif (it.held != 0) $1[0] = @max(0, @min(1, $1[0] - it.dy / 200));",
      "\tif (ui.canvas()) |c| c.arc(it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], ui.theme().accent);",
      "}"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "\tconst g = goome.Goome.openOffscreen(${1:640}, ${2:480}, 1) catch |e| {",
      "\t\tstd.debug.print(\"couldnt open offscreen: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "\t\tstd.process.exit(1);",
      "\t};",
      "\tdefer g.deinit();",
      "\tconst ui = try g.ui();",
      "\tdefer ui.deinit();",
      "\ttry g.pushClick(${3:60}, ${4:60});",
      "\twhile (try g.poll(0)) |ev| _ = ui.feed(ev);",
      "\tif (ui.begin(0) != null) {",
      "\t\t_ = ui.app(\"${5:offscreen}\", 0);",
      "\t\t$0",
      "\t\tui.appEnd();",
      "\t\tui.end();",
      "\t}",
      "\tconst frame = try g.frame();",
      "\ttry frame.savePpm(\"${6:frame.ppm}\");",
      "}"
    ]
  },
