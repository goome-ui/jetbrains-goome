{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "\tconst g = goome.Goome.open(.{ .title = \"${1:my overlay}\" }) catch |e| {",
      "\t\tstd.debug.print(\"couldnt open an overlay: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "\t\tstd.process.exit(1);",
      "\t};",
      "\tdefer g.deinit();",
      "\tconst ui = try g.ui();",
      "\tdefer ui.deinit();",
      "\tvar win: goome.Window = .{ .x = 60, .y = 60, .w = 280 };",
      "\twhile (win.isOpen()) {",
      "\t\twhile (try g.poll(16)) |ev| {",
      "\t\t\tif (ev.kind == .quit) win.setOpen(false);",
      "\t\t\t_ = ui.feed(ev);",
      "\t\t}",
      "\t\tif (!win.isOpen()) break;",
      "\t\t_ = ui.begin(0) orelse continue;",
      "\t\tif (ui.window(\"$1\", &win, goome.win.move | goome.win.close)) {",
      "\t\t\tui.label(\"${2:im on top of everything}\");",
      "\t\t\t$0",
      "\t\t}",
      "\t\tui.windowEnd();",
      "\t\tui.end();",
      "\t}",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "\tconst g = goome.Goome.openApp(\"${1:My App}\", ${2:960}, ${3:640}) catch |e| {",
      "\t\tstd.debug.print(\"couldnt open a window: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "\t\tstd.process.exit(1);",
      "\t};",
      "\tdefer g.deinit();",
      "\tconst ui = try g.ui();",
      "\tdefer ui.deinit();",
      "\tvar running = true;",
      "\twhile (running) {",
      "\t\twhile (try g.poll(16)) |ev| {",
      "\t\t\tif (ev.kind == .quit or ev.kind == .close) running = false;",
      "\t\t\t_ = ui.feed(ev);",
      "\t\t}",
      "\t\tif (!running) break;",
      "\t\t_ = ui.begin(0) orelse continue;",
      "\t\t_ = ui.app(\"$1\", 0);",
      "\t\tui.heading(\"${4:Hello}\");",
      "\t\t$0",
      "\t\tui.appEnd();",
      "\t\tui.end();",
      "\t}",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "var pace: goome.Pacer = .{};",
      "var running = true;",
      "var dirty = true;",
      "while (running) {",
      "\tvar wait = if (dirty or ${1:ui}.animating()) pace.wait(${2:60}) else 500;",
      "\twhile (try ${3:g}.poll(wait)) |ev| {",
      "\t\tif (ev.kind == .quit or ev.kind == .close) running = false;",
      "\t\t_ = $1.feed(ev);",
      "\t\tdirty = true;",
      "\t\twait = 0;",
      "\t}",
      "\tif (!running) break;",
      "\tif (!dirty and !$1.animating()) continue;",
      "\tdirty = false;",
      "\t_ = $1.begin(0) orelse continue;",
      "\t$0",
      "\t$1.end();",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "if (ui.window(\"${1:Window}\", &${2:win}, goome.win.move | goome.win.resize | goome.win.collapse)) {",
      "\tui.label(\"${3:hello}\");",
      "\tif (ui.button(\"${4:Click me}\")) {",
      "\t\t$0",
      "\t}",
      "}",
      "ui.windowEnd();"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "if (${1:g}.begin(0)) |c| {",
      "\tc.clear();",
      "\tc.roundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22);",
      "\t_ = c.text($2 + 12, $3 + 12, \"${6:hello}\", true, 0xFFE9EBEE);",
      "\t$0",
      "\ttry $1.end(c, &.{goome.rect($2, $3, $4, $5)});",
      "}"
    ]
  },
