    "prefix": "goome-hotkey",
    "description": "global hotkey and where it fires",
    "body": [
      "g.hotkey(\"${1:alt+m}\", ${2:1}) catch std.debug.print(\"couldnt grab $1: {s}\\n\", .{g.lastError()});",
      "$0",
      "if (ev.kind == .hotkey and ev.id == $2) {",
      "}"
    ]
  },
