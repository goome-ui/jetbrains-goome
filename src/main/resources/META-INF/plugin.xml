<idea-plugin>
    <id>io.github.goomeui.goome</id>
    <name>goome</name>
    <vendor url="https://goome-ui.github.io/docs/">goome-ui</vendor>
    <description><![CDATA[
<p>Live templates, a new project action, a .goome.json preview and quick docs for <a href="https://goome-ui.github.io/docs/">goome</a>. See-through overlays, normal app windows, game mod menus and engine ui. One file, no dependencies, Linux, Windows, Mac.</p>
<ul>
<li>type <code>goome</code> in C, C#, Python or Java and pick a template, same names as the VS Code extension</li>
<li>a goome tool window on the left, next to Project: quick actions, every .goome.json in the project, templates that start New Project with them picked, and a snippet cheat sheet</li>
<li><b>Tools &gt; goome: New Project</b> runs goome-cli and opens what it made</li>
<li>.goome.json and .goome-theme.json get checked against the goome schemas while you type</li>
<li>.goome.json opens with a live read only preview, plus buttons that copy the C, C#, Python or Java code</li>
<li><b>Tools &gt; goome: Build for Web</b> runs <code>goome build --web</code> on a C app, then opens it in the browser through <code>goome serve</code></li>
<li>quick docs for <code>goome_*</code> C functions, and <b>goome: Search Docs</b> everywhere</li>
</ul>
<p>Works in Rider, CLion, IntelliJ IDEA and PyCharm, each gets the parts that fit it.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends optional="true" config-file="goome-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="goome-python.xml">com.intellij.modules.python</depends>
    <depends optional="true" config-file="goome-c.xml">com.intellij.modules.clion</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="goome project" implementationClass="io.github.goomeui.goome.GoomeProjectFileType" fieldName="INSTANCE" language="JSON" patterns="*.goome.json"/>
        <fileType name="goome theme" implementationClass="io.github.goomeui.goome.GoomeThemeFileType" fieldName="INSTANCE" language="JSON" patterns="*.goome-theme.json"/>
        <fileEditorProvider implementation="io.github.goomeui.goome.preview.GoomePreviewProvider"/>
        <toolWindow id="goome" anchor="left" icon="/icons/toolWindowGoome.svg" factoryClass="io.github.goomeui.goome.sidebar.GoomeToolWindowFactory"/>
        <iconMapper mappingFile="GoomeIconMappings.json"/>
        <applicationService serviceImplementation="io.github.goomeui.goome.GoomeSettings"/>
        <applicationConfigurable parentId="tools" instance="io.github.goomeui.goome.GoomeConfigurable" id="goome.settings" displayName="goome"/>
        <notificationGroup id="goome" displayType="BALLOON"/>
        <notificationGroup id="goome.web" displayType="STICKY_BALLOON"/>
        <toolWindow id="goome build" anchor="bottom" secondary="true" canCloseContents="false" icon="/icons/toolWindowGoome.svg" factoryClass="io.github.goomeui.goome.web.WebLogToolWindowFactory"/>
        <platform.backend.documentation.targetProvider implementation="io.github.goomeui.goome.docs.GoomeDocTargets"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="io.github.goomeui.goome.GoomeSchemas"/>
    </extensions>

    <actions>
        <group id="goome.Tools" text="goome" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="goome.NewProject" class="io.github.goomeui.goome.newproject.NewProjectAction" text="goome: New Project..." description="Make a goome project with goome-cli and open it">
                <add-to-group group-id="WelcomeScreen.QuickStart" anchor="last"/>
            </action>
            <action id="goome.SearchDocs" class="io.github.goomeui.goome.docs.SearchDocsAction" text="goome: Search Docs..." description="Find a goome function and open its docs"/>
            <action id="goome.OpenBuilder" class="io.github.goomeui.goome.preview.OpenBuilderAction" text="goome: Open UI Builder" description="Open the goome UI builder in the browser"/>
            <action id="goome.BuildWeb" class="io.github.goomeui.goome.web.WebBuildAction" text="goome: Build for Web" description="Compile the app to WebAssembly with goome build --web">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
                <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            </action>
            <action id="goome.StopWebServer" class="io.github.goomeui.goome.web.StopWebServerAction" text="goome: Stop Web Server" description="Stop the goome serve process started by Build for Web"/>
        </group>
    </actions>
</idea-plugin>
